#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt { tapping-term-ms = <235>; };

/ {
    combos {
        compatible = "zmk,combos";

        cmb_ru_io {
            bindings = <&kp RU_CYRILLIC_IO>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmb_ru_hs {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <19 20>;
            layers = <1>;
        };

        cmb_ru_cio {
            bindings = <&kp LS(RU_CYRILLIC_IO)>;
            key-positions = <15 16>;
            layers = <12>;
        };

        cmb_ru_chs {
            bindings = <&kp LS(RU_CYRILLIC_HARD_SIGN)>;
            key-positions = <19 20>;
            layers = <11>;
        };

        cmb_home {
            bindings = <&kp HOME>;
            key-positions = <19 20>;
            layers = <3 4>;
        };

        cmb_s_home {
            bindings = <&kp LS(HOME)>;
            key-positions = <19 20>;
            layers = <7>;
        };

        cmd_end {
            bindings = <&kp END>;
            key-positions = <20 21>;
            layers = <3 4>;
        };

        cmb_s_end {
            bindings = <&kp LS(END)>;
            key-positions = <20 21>;
            layers = <7>;
        };
    };

    macros {
        lay_en: lay_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&off 1>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        lay_ru: lay_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&on 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N1))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 23>,
                <&macro_tap>,
                <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <23>;
        };

        ru: ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N2))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 30>,
                <&macro_tap>,
                <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        key: key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap>, <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd: cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd_f15: cmd_f15 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F15>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        nvoff_mo: nvoff_mo {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1 &off MACRO_PLACEHOLDER &macro_param_2to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1 &off MACRO_PLACEHOLDER &off 7>;

            label = "NVOFF_MO";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_EN";
        };

        nav_mo: nav_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&off 7 &macro_param_1to1 &off MACRO_PLACEHOLDER>;

            label = "NAV_MO";
        };

        edt_off_kp: edt_off_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &off 7>;

            label = "EDT_OFF_KP";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        eoff_fnxt: eoff_fnxt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&cmd_f15 F &off 7>;

            label = "EOFF_FNXT";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_RU";
        };

        cmd_f16: cmd_f16 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F16>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
            label = "CMD_F16";
        };

        eof_sfnxt: eof_sfnxt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&cmd_f15 LS(F) &off 7>;

            label = "EOF_SFNXT";
            tap-ms = <30>;
            wait-ms = <0>;
        };
    };

    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        on: on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        off: off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        ltk: ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            hold-while-undecided;
        };

        bksp_del: bksp_del {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_LSFT)>;
            keep-mods = <(MOD_LALT)>;
        };

        sl_bslh_e: sl_bslh_e {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BSLH_E";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sl_bslh_r: sl_bslh_r {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BSLH_R";
            bindings = <&kp RU_SLASH>, <&kp RU_BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_sl: mo_sl {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            label = "MO_SL";
        };

        dqt_no_e: dqt_no_e {
            compatible = "zmk,behavior-mod-morph";
            label = "DQT_NO_E";
            bindings = <&ru RU_DOUBLE_QUOTES>, <&ru RU_NUMERO>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dqt_no_r: dqt_no_r {
            compatible = "zmk,behavior-mod-morph";
            label = "DQT_NO_R";
            bindings = <&kp RU_DOUBLE_QUOTES>, <&kp RU_NUMERO>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        caps_layen: caps_layen {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_LAYEN";
            bindings = <&kp LC(CAPSLOCK)>, <&lay_en>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        find_nxt: find_nxt {
            compatible = "zmk,behavior-mod-morph";
            label = "FIND_NXT";
            bindings = <&cmd_f15 F>, <&cmd_f15 LS(F)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_ltk: nav_ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&nav_mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "NAV_LTK";
        };

        exc_sem_e: exc_sem_e {
            compatible = "zmk,behavior-mod-morph";
            label = "EXC_SEM_E";
            bindings = <&kp EXCLAMATION>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        exc_sem_r: exc_sem_r {
            compatible = "zmk,behavior-mod-morph";
            label = "EXC_SEM_R";
            bindings = <&kp RU_EXCLAMATION>, <&kp RU_SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ltk_repeat: ltk_repeat {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "LTK_REPEAT";
            retro-tap;
        };

        lr_brace: lr_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "LR_BRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "En";
            bindings = <
&kp ESC           &cmd_f16 F13  &cmd_f16 F14  &cmd_f16 F15  &cmd_f16 F16   &cmd_f16 F17                                &kp C_MUTE        &kp C_VOL_DN  &sl 15     &kp C_VOL_UP  &bksp_del   &none
&kp ESC           &kp Q         &kp W         &kp E         &kp R          &kp T                                       &kp Y             &kp U         &kp I      &kp O         &kp P       &lr_brace
&kp CAPSLOCK      &kp A         &kp S         &kp D         &kp F          &kp G                                       &kp H             &kp J         &kp K      &kp L         &kp SEMI    &kp APOSTROPHE
&sk LEFT_CONTROL  &kp Z         &kp X         &kp C         &kp V          &kp B         &layer_en       &layer_ru     &kp N             &kp M         &kp COMMA  &kp DOT       &sl_bslh_e  &sk RIGHT_CONTROL
                                &kp GRAVE     &dqt_no_e     &mt LSHFT TAB  &ltk 3 SPACE  &mo_sl 10 10    &mo_sl 12 12  &nav_ltk 5 SPACE  &kp ENTER     &kp LBKT   &kp RBKT
            >;

            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &trans                   &trans                &trans              &trans              &trans                                &trans              &trans                     &trans               &trans                     &trans               &trans
&trans  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&trans  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE         &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&trans  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans    &trans  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU         &sl_bslh_r           &trans
                                 &kp RU_CYRILLIC_IO    &dqt_no_r           &trans              &trans              &trans    &trans  &trans              &trans                     &kp RU_CYRILLIC_HA   &kp RU_CYRILLIC_HARD_SIGN
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&trans  &none      &none      &none      &none      &none                     &none          &none          &kp LS(LC(M))  &none          &none       &trans
&trans  &kp LC(Y)  &none      &none      &none      &none                     &kp LC(HOME)   &kp LC(LEFT)   &kp UP         &kp LC(RIGHT)  &none       &none
&trans  &none      &kp LC(S)  &kp LC(D)  &find_nxt  &none                     &kp HOME       &kp LEFT       &kp DOWN       &kp RIGHT      &on 7       &kp END
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none   &trans    &trans  &kp LC(END)    &kp BACKSPACE  &kp PG_DN      &kp PG_UP      &kp DELETE  &trans
                   &none      &none      &trans     &trans  &trans    &trans  &nvoff_mo 2 5  &trans         &none          &none
            >;
        };

        act-sym-en {
            display-name = "act_sym";
            bindings = <
&none  &none      &none      &none      &none      &none                     &kp C_PP     &kp C_PREV      &kp LS(LC(M))         &kp C_NEXT             &none      &none
&none  &kp LC(Y)  &none      &none      &none      &none                     &kp CARET    &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE   &kp SEMICOLON
&none  &mo 13     &kp LC(S)  &kp LC(D)  &find_nxt  &none                     &kp EXCL     &kp MINUS       &kp PLUS              &kp EQUAL              &kp COLON  &kp DOUBLE_QUOTES
&none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none   &trans    &trans  &kp PERCENT  &kp UNDERSCORE  &kp LT                &kp GT                 &kp DOT    &none
                  &none      &none      &trans     &trans  &trans    &trans  &trans       &kp LS(ENTER)   &none                 &none
            >;
        };

        act-sym-ru {
            display-name = "act-sym";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &en CARET       &trans  &trans  &trans  &en PIPE      &kp RU_SEMI
&trans  &trans  &trans  &trans  &trans  &trans                    &kp RU_EXCL     &trans  &trans  &trans  &kp RU_COLON  &kp RU_DOUBLE_QUOTES
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp RU_PERCENT  &trans  &en LT  &en GT  &kp RU_DOT    &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        num-nav-en {
            display-name = "num_nav";
            bindings = <
&none    &cmd_f16 F18  &cmd_f16 F19      &cmd_f16 F20       &cmd_f16 F21    &cmd_f16 F22                     &none         &none          &none          &none          &none       &none
&kp ESC  &kp N1        &kp N2            &kp N3             &kp N4          &kp N5                           &kp LC(HOME)  &kp LC(LEFT)   &kp UP         &kp LC(RIGHT)  &on 2       &none
&lay_ru  &kp N6        &kp N7            &kp N8             &kp N9          &kp N0                           &kp HOME      &kp LEFT       &kp DOWN       &kp RIGHT      &on 7       &kp END
&none    &kp COMMA     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp APOSTROPHE  &kp AMPERSAND  &trans    &trans  &kp LC(END)   &kp BACKSPACE  &kp PAGE_DOWN  &kp PAGE_UP    &kp DELETE  &none
                       &none             &none              &kp LS(TAB)     &trans         &trans    &trans  &trans        &trans         &none          &none
            >;
        };

        num-nav-ru {
            display-name = "num-nav";
            bindings = <
&trans   &trans        &trans            &trans             &trans          &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans        &trans            &trans             &trans          &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&lay_en  &trans        &trans            &trans             &trans          &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp RU_COMMA  &en LEFT_BRACKET  &en RIGHT_BRACKET  &en APOSTROPHE  &en AMPERSAND  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                       &trans            &trans             &trans          &trans         &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav-sel {
            display-name = "nav_sel";
            bindings = <
&none   &none  &none  &none  &none   &none                     &none             &none                  &none          &none              &none               &none
&none   &none  &none  &none  &none   &none                     &kp LS(LC(HOME))  &kp LC(LS(LEFT))       &kp LS(UP)     &kp LC(LS(RIGHT))  &on 2               &none
&trans  &none  &none  &none  &none   &none                     &kp LS(HOME)      &kp LS(LEFT)           &kp LS(DOWN)   &kp LS(RIGHT)      &off 7              &kp LS(END)
&none   &none  &none  &none  &none   &none   &trans    &trans  &kp LS(LC(END))   &edt_off_kp BACKSPACE  &kp LS(PG_DN)  &kp LS(PG_UP)      &edt_off_kp DELETE  &none
               &none  &none  &trans  &trans  &trans    &trans  &trans            &trans                 &none          &none
            >;

            label = "nav-sel";
        };

        ext-nav {
            display-name = "ext-nav";
            bindings = <
&bootloader   &none  &kp F23        &none          &kp F24         &none                             &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2           &bt BT_SEL 3       &bt BT_SEL 4    &bt BT_CLR
&none         &none  &none          &none          &none           &none                             &none         &none              &kp LA(LC(UP))         &none              &on 2           &none
&none         &none  &kp LS(LG(S))  &kp LC(E)      &cmd_f15 LS(F)  &kp INS                           &none         &kp LA(LEFT)       &kp LA(LC(DOWN))       &kp LA(RIGHT)      &on 7           &none
&out OUT_USB  &none  &kp LS(LC(X))  &kp LS(LC(C))  &kp LS(LC(V))   &kp SCROLLLOCK  &trans    &trans  &none         &kp LC(BACKSPACE)  &kp LA(LC(PAGE_DOWN))  &kp LA(LC(PG_UP))  &kp LS(DELETE)  &out OUT_BLE
                     &none          &none          &trans          &trans          &trans    &trans  &trans        &trans             &none                  &none
            >;
        };

        ext-nav-sel {
            bindings = <
&trans  &trans  &trans                 &trans                 &trans                 &trans                    &trans  &trans            &trans  &trans             &trans  &trans
&trans  &trans  &trans                 &trans                 &trans                 &trans                    &trans  &trans            &trans  &trans             &trans  &trans
&trans  &trans  &trans                 &kp LC(E)              &trans                 &trans                    &trans  &kp LS(LA(LEFT))  &trans  &kp LS(LA(RIGHT))  &off 7  &trans
&trans  &trans  &edt_off_kp LS(LC(X))  &edt_off_kp LS(LC(C))  &edt_off_kp LS(LC(V))  &trans  &trans    &trans  &trans  &trans            &trans  &trans             &trans  &trans
                &trans                 &trans                 &trans                 &trans  &trans    &trans  &trans  &trans            &trans  &trans
            >;

            label = "ext-nav-sel";
        };

        l-up-en {
            display-name = "l_up";
            bindings = <
&none  &none    &none    &none    &none    &none                      &none                   &none          &none      &none      &none          &none
&none  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                     &kp LS(Y)               &kp LS(U)      &kp LS(I)  &kp LS(O)  &kp LS(P)      &kp RIGHT_BRACE
&none  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                    &kp LS(H)               &kp LS(J)      &kp LS(K)  &kp LS(L)  &kp COLON      &kp DOUBLE_QUOTES
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans    &trans  &kp LS(N)               &kp LS(M)      &kp LT     &kp GT     &kp BACKSLASH  &none
                &none    &none    &kp F16  &trans   &trans    &trans  &nav_ltk (5) LS(SPACE)  &kp LS(ENTER)  &none      &none
            >;
        };

        l-up-ru {
            display-name = "l-up";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans                  &trans                         &trans                   &trans                         &trans                   &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LS(RU_CYRILLIC_EN)  &kp LS(RU_CYRILLIC_GHE)        &kp LS(RU_CYRILLIC_SHA)  &kp LS(RU_CYRILLIC_SHCHA)      &kp LS(RU_CYRILLIC_ZE)   &kp LS(RU_CYRILLIC_HA)
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LS(RU_CYRILLIC_ER)  &kp LS(RU_CYRILLIC_O)          &kp LS(RU_CYRILLIC_EL)   &kp LS(RU_CYRILLIC_DE)         &kp LS(RU_CYRILLIC_ZHE)  &kp LS(RU_CYRILLIC_E)
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LS(RU_CYRILLIC_TE)  &kp LS(RU_CYRILLIC_SOFT_SIGN)  &kp LS(RU_CYRILLIC_BE)   &kp LS(RU_CYRILLIC_YU)         &kp RU_BACKSLASH         &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans                         &kp LS(RU_CYRILLIC_HA)   &kp LS(RU_CYRILLIC_HARD_SIGN)
            >;
        };

        r-up {
            bindings = <
&none        &none      &none      &none      &none        &none                                 &none        &none         &none      &none     &none      &none
&kp LS(ESC)  &kp LS(Q)  &kp LS(W)  &kp LS(E)  &kp LS(R)    &kp LS(T)                             &none        &none         &none      &none     &none      &none
&lay_en      &kp LS(A)  &kp LS(S)  &kp LS(D)  &kp LS(F)    &kp LS(G)                             &key_repeat  &sk LEFT_ALT  &sk LCTRL  &sk LGUI  &sk LSHFT  &none
&none        &kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)    &kp LS(B)           &trans    &trans  &none        &sk RALT      &sk RCTRL  &sk RGUI  &sk RSHFT  &none
                        &none      &none      &kp LS(TAB)  &ltk (3) LS(SPACE)  &trans    &trans  &trans       &trans        &none      &none
            >;

            label = "r-up";
        };

        sym-en {
            display-name = "sym_en";
            bindings = <
&none  &none  &none  &none  &none   &none                     &none          &none          &none           &none            &none          &none
&none  &none  &none  &none  &none   &none                     &ru RU_NUMERO  &none          &kp LEFT_BRACE  &kp RIGHT_BRACE  &none          &none
&none  &none  &none  &none  &none   &none                     &kp QUESTION   &kp TILDE      &kp AT          &kp DOLLAR       &kp SEMICOLON  &kp APOSTROPHE
&none  &none  &none  &none  &none   &none   &trans    &trans  &none          &kp GRAVE      &kp COMMA       &kp DOT          &kp HASH       &none
              &none  &none  &trans  &trans  &trans    &trans  &trans         &kp LC(ENTER)  &none           &none
            >;
        };

        sym-ru {
            display-name = "sym-ru";
            bindings = <
&none  &none  &none  &none  &none   &none                     &none            &none          &none           &none            &none             &none
&none  &none  &none  &none  &none   &none                     &kp RU_NUMERO    &trans         &en LEFT_BRACE  &en RIGHT_BRACE  &trans            &trans
&none  &none  &none  &none  &none   &none                     &kp RU_QUESTION  &en TILDE      &en AT          &en DOLLAR       &kp RU_SEMICOLON  &en APOSTROPHE
&none  &none  &none  &none  &none   &none   &trans    &trans  &trans           &en GRAVE      &kp RU_COMMA    &kp RU_DOT       &en HASH          &trans
              &none  &none  &trans  &trans  &trans    &trans  &trans           &kp LC(ENTER)  &none           &none
            >;
        };

        desktop {
            bindings = <
&trans       &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&kp LA(TAB)  &cmd_f15 F1   &cmd_f15 F2   &cmd_f15 F3   &cmd_f15 F4   &cmd_f15 F5                     &trans  &trans  &trans  &trans  &trans  &trans
&trans       &cmd_f15 F6   &cmd_f15 F7   &cmd_f15 F8   &cmd_f15 F9   &cmd_f15 F10                    &trans  &trans  &trans  &trans  &trans  &trans
&trans       &cmd_f15 F11  &cmd_f15 F12  &cmd_f15 F13  &cmd_f15 F14  &cmd_f15 F15  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "desktop";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        numsymru {
            if-layers = <5 1>;
            then-layer = <6>;
        };

        fnnavru {
            if-layers = <3 1>;
            then-layer = <4>;
        };

        ext-nav {
            if-layers = <3 5>;
            then-layer = <8>;
        };

        ext-nav-sel {
            if-layers = <3 5 7>;
            then-layer = <9>;
        };

        ext-nav-p {
            if-layers = <2 5>;
            then-layer = <8>;
        };

        ext-nav-sel-p {
            if-layers = <2 5 7>;
            then-layer = <9>;
        };

        l-up {
            if-layers = <1 10>;
            then-layer = <11>;
        };

        sym-ru {
            if-layers = <1 13>;
            then-layer = <14>;
        };
    };
};
