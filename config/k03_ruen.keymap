#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        cmb_ru_io {
            bindings = <&kp RU_CYRILLIC_IO>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmb_ru_hs {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <45 46>;
            layers = <1>;
        };

        cmb_ru_c_io {
            bindings = <&kp LS(RU_CYRILLIC_IO)>;
            key-positions = <15 16>;
            layers = <10>;
        };

        cmb_ru_c_hs {
            bindings = <&kp LS(RU_CYRILLIC_HARD_SIGN)>;
            key-positions = <45 46>;
            layers = <9>;
        };

        cmb_ru_comma {
            bindings = <&kp RU_COMMA>;
            key-positions = <46 47>;
            layers = <1>;
        };

        cmb_en_comma {
            bindings = <&kp COMMA>;
            key-positions = <46 47>;
            layers = <0>;
        };

        cmb_lay_en {
            bindings = <&lay_en>;
            key-positions = <19 20>;
            layers = <1>;
        };

        cmb_lay_ru {
            bindings = <&lay_ru>;
            key-positions = <19 20>;
            layers = <0>;
        };
    };

    macros {
        lay_en: lay_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&off 1>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        lay_ru: lay_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&on 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N1))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 23>,
                <&macro_tap>,
                <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <23>;
        };

        ru: ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N2))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 30>,
                <&macro_tap>,
                <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        key: key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap>, <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd: cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd_f15: cmd_f15 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F15>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        nvoff_mo: nvoff_mo {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1 &off MACRO_PLACEHOLDER &macro_param_2to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_2to1 &off MACRO_PLACEHOLDER>;

            label = "NVOFF_MO";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_EN";
        };

        nav_mo: nav_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER>;

            label = "NAV_MO";
            wait-ms = <0>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_RU";
        };

        cmd_f16: cmd_f16 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F16>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
            label = "CMD_F16";
        };

        nav_mo_l: nav_mo_l {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER &off 10>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER>;

            label = "NAV_MO_L";
            wait-ms = <0>;
        };

        ext_nav_mo_l: ext_nav_mo_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&on 3 &on 5 &off 8>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&off 3 &off 5>;

            label = "EXT_NAV_MO_L";
            wait-ms = <0>;
        };
    };

    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        on: on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        off: off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        ltk: ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
        };

        sl_bslh_e: sl_bslh_e {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BSLH_E";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sl_bslh_r: sl_bslh_r {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BSLH_R";
            bindings = <&kp RU_SLASH>, <&kp RU_BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_sl: mo_sl {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            label = "MO_SL";
        };

        find_nxt: find_nxt {
            compatible = "zmk,behavior-mod-morph";
            label = "FIND_NXT";
            bindings = <&cmd_f15 F>, <&cmd_f15 LS(F)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_ltk: nav_ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&nav_mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "NAV_LTK";
        };

        lr_bkt: lr_bkt {
            compatible = "zmk,behavior-mod-morph";
            label = "LR_BKT";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            flavor = "hold-preferred";
            label = "KP_SK";
            hold-while-undecided;
            hold-while-undecided-linger;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "En";
            bindings = <
&kp ESC       &cmd_f16 F13  &cmd_f16 F14      &cmd_f16 F15        &cmd_f16 F16  &cmd_f16 F17                              &kp LS(LC(M))     &kp C_VOL_DN  &kp C_MUTE          &kp C_VOL_UP      &none       &none
&kp TAB       &kp Q         &kp W             &kp E               &kp R         &kp T                                     &kp Y             &kp U         &kp I               &kp O             &kp P       &lr_bkt
&kp CAPSLOCK  &kp A         &kp S             &kp D               &kp F         &kp G                                     &kp H             &kp J         &kp K               &kp L             &kp SEMI    &kp APOSTROPHE
&layer_en     &kp Z         &kp X             &kp C               &kp V         &kp B         &layer_en     &layer_ru     &kp N             &kp M         &kp COMMA           &kp DOT           &sl_bslh_e  &layer_ru
                            &kp_sk LGUI LGUI  &kp_sk LCTRL LCTRL  &kp ESC       &ltk 3 SPACE  &mo_sl 8 8    &mo_sl 10 10  &nav_ltk 5 SPACE  &kp ENTER     &kp_sk RCTRL RCTRL  &kp_sk LALT LALT
            >;

            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &trans                   &trans                &trans              &trans              &trans                                &trans              &trans                     &trans               &trans                 &trans               &trans
&trans  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&trans  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&trans  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans    &trans  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &sl_bslh_r           &trans
                                 &trans                &trans              &trans              &trans              &trans    &trans  &trans              &trans                     &trans               &trans
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&trans  &none      &none      &none      &none      &none                     &none          &none          &none     &none          &none      &trans
&trans  &none      &kp LC(E)  &mo 10     &none      &none                     &none          &kp LC(LEFT)   &kp UP    &kp LC(RIGHT)  &none      &none
&trans  &kp LSHFT  &kp LC(S)  &kp LC(D)  &find_nxt  &none                     &none          &kp LEFT       &kp DOWN  &kp RIGHT      &none      &none
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none   &trans    &trans  &none          &kp BACKSPACE  &none     &kp DELETE     &kp LC(Y)  &trans
                   &none      &none      &trans     &trans  &trans    &trans  &nvoff_mo 2 5  &trans         &none     &none
            >;
        };

        act-sym-en {
            display-name = "act_sym";
            bindings = <
&none  &none          &none      &none      &none      &none                            &none          &kp C_PREV      &kp C_PP              &kp C_NEXT             &none            &none
&none  &kp SEMICOLON  &kp TILDE  &kp AT     &kp HASH   &ru RU_NUMERO                    &kp AMPERSAND  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp PIPE
&none  &kp LSHFT      &kp LC(S)  &kp LC(D)  &find_nxt  &kp DOLLAR                       &kp PLUS       &kp MINUS       &kp ASTERISK          &kp EQUAL              &kp COLON        &kp DOUBLE_QUOTES
&none  &kp LC(Z)      &kp LC(X)  &kp LC(C)  &kp LC(V)  &none          &trans    &trans  &kp EXCL       &kp UNDERSCORE  &kp LT                &kp GT                 &kp QUESTION     &none
                      &none      &none      &trans     &trans         &trans    &trans  &trans         &kp LS(ENTER)   &none                 &none
            >;
        };

        act-sym-ru {
            display-name = "act-sym";
            bindings = <
&trans  &trans            &trans     &trans  &trans    &trans                           &trans              &trans          &trans  &trans  &trans           &trans
&trans  &kp RU_SEMICOLON  &en TILDE  &en AT  &en HASH  &kp RU_NUMERO                    &en AMPERSAND       &en LEFT_BRACE  &trans  &trans  &en RIGHT_BRACE  &en PIPE
&trans  &trans            &trans     &trans  &trans    &en DOLLAR                       &trans              &trans          &trans  &trans  &kp RU_COLON     &kp RU_DOUBLE_QUOTES
&trans  &trans            &trans     &trans  &trans    &trans         &trans    &trans  &kp RU_EXCLAMATION  &trans          &en LT  &en GT  &kp RU_QUESTION  &trans
                          &trans     &trans  &trans    &trans         &trans    &trans  &trans              &trans          &trans  &trans
            >;
        };

        num-nav-en {
            display-name = "num_nav";
            bindings = <
&none           &cmd_f16 F18  &cmd_f16 F19      &cmd_f16 F20       &cmd_f16 F21  &cmd_f16 F22                    &none   &none          &none     &none          &none      &none
&kp GRAVE       &kp N1        &kp N2            &kp N3             &kp N4        &kp N5                          &none   &kp LC(LEFT)   &kp UP    &kp LC(RIGHT)  &none      &none
&kp APOSTROPHE  &kp N6        &kp N7            &kp N8             &kp N9        &kp N0                          &none   &kp LEFT       &kp DOWN  &kp RIGHT      &lay_ru    &none
&none           &kp DOT       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp CARET     &kp PERCENT   &trans    &trans  &none   &kp BACKSPACE  &on 2     &kp DELETE     &kp LC(Y)  &none
                              &none             &none              &trans        &trans        &trans    &trans  &trans  &trans         &none     &none
            >;
        };

        num-nav-ru {
            display-name = "num-nav";
            bindings = <
&trans          &trans      &trans            &trans             &trans     &trans                            &trans  &trans  &trans  &trans  &trans   &trans
&en GRAVE       &trans      &trans            &trans             &trans     &trans                            &trans  &trans  &trans  &trans  &trans   &trans
&en APOSTROPHE  &trans      &trans            &trans             &trans     &trans                            &trans  &trans  &trans  &trans  &lay_en  &trans
&trans          &kp RU_DOT  &en LEFT_BRACKET  &en RIGHT_BRACKET  &en CARET  &kp RU_PERCENT  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
                            &trans            &trans             &trans     &trans          &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        ext-nav {
            display-name = "ext-nav";
            bindings = <
&bootloader   &none      &kp F23        &none          &kp F24         &none                             &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4  &bt BT_CLR
&none         &none      &kp LC(E)      &lay_en        &lay_ru         &none                             &none         &kp LS(LC(LEFT))   &kp LS(UP)    &kp LS(LC(RIGHT))  &none         &none
&none         &none      &kp LS(LG(S))  &kp LC(LS(D))  &cmd_f15 LS(F)  &kp INS                           &none         &kp LS(LEFT)       &kp LS(DOWN)  &kp LS(RIGHT)      &lay_en       &none
&out OUT_USB  &kp LC(Z)  &kp LC(X)      &kp LC(C)      &kp LC(V)       &kp SCROLLLOCK  &trans    &trans  &none         &kp LC(BACKSPACE)  &on 2         &kp LS(DELETE)     &kp LC(Y)     &out OUT_BLE
                         &none          &none          &trans          &trans          &trans    &trans  &trans        &trans             &none         &none
            >;
        };

        l-up-en {
            display-name = "l_up";
            bindings = <
&none    &none    &none    &none    &none    &none                            &none                   &none          &none      &none      &none          &none
&kp F16  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                           &kp LS(Y)               &kp LS(U)      &kp LS(I)  &kp LS(O)  &kp LS(P)      &kp RIGHT_BRACKET
&none    &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                          &kp LS(H)               &kp LS(J)      &kp LS(K)  &kp LS(L)  &kp COLON      &kp DOUBLE_QUOTES
&none    &kp F11  &kp F12  &kp F13  &kp F14  &kp F15        &trans    &trans  &kp LS(N)               &kp LS(M)      &kp LT     &kp GT     &kp BACKSLASH  &none
                  &none    &none    &trans   &ext_nav_mo_l  &trans    &trans  &nav_ltk (5) LS(SPACE)  &kp LC(ENTER)  &none      &none
            >;
        };

        l-up-ru {
            display-name = "l-up";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans                  &trans                         &trans                   &trans                         &trans                   &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LS(RU_CYRILLIC_EN)  &kp LS(RU_CYRILLIC_GHE)        &kp LS(RU_CYRILLIC_SHA)  &kp LS(RU_CYRILLIC_SHCHA)      &kp LS(RU_CYRILLIC_ZE)   &kp LS(RU_CYRILLIC_HA)
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LS(RU_CYRILLIC_ER)  &kp LS(RU_CYRILLIC_O)          &kp LS(RU_CYRILLIC_EL)   &kp LS(RU_CYRILLIC_DE)         &kp LS(RU_CYRILLIC_ZHE)  &kp LS(RU_CYRILLIC_E)
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LS(RU_CYRILLIC_TE)  &kp LS(RU_CYRILLIC_SOFT_SIGN)  &kp LS(RU_CYRILLIC_BE)   &kp LS(RU_CYRILLIC_YU)         &kp RU_BACKSLASH         &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans                         &kp LS(RU_CYRILLIC_HA)   &kp LS(RU_CYRILLIC_HARD_SIGN)
            >;
        };

        r-up {
            bindings = <
&none        &none      &none          &none      &none      &none                          &none         &none         &none      &none          &none  &none
&kp LS(TAB)  &kp LS(Q)  &kp LS(W)      &kp LS(E)  &kp LS(R)  &kp LS(T)                      &kp LC(HOME)  &kp LA(LEFT)  &kp PG_UP  &kp LA(RIGHT)  &none  &none
&none        &kp LS(A)  &kp LS(S)      &kp LS(D)  &kp LS(F)  &kp LS(G)                      &key_repeat   &kp HOME      &kp PG_DN  &kp END        &none  &none
&none        &kp LS(Z)  &kp LS(X)      &kp LS(C)  &kp LS(V)  &kp LS(B)    &trans    &trans  &kp LC(END)   &none         &none      &none          &none  &none
                        &kp LS(GRAVE)  &none      &trans     &nav_mo_l 2  &trans    &trans  &sl 12        &trans        &none      &none
            >;

            label = "r-up";
        };

        r-up-sel {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans            &trans            &trans         &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LS(LC(HOME))  &kp LS(LA(LEFT))  &kp LS(PG_UP)  &kp LS(LA(RIGHT))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans            &kp LS(HOME)      &kp LS(PG_DN)  &kp LS(END)        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LS(LC(END))   &trans            &trans         &trans             &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans            &trans         &trans
            >;

            label = "r-up-sel";
        };

        desk-extra {
            bindings = <
&trans       &trans        &trans        &trans        &trans        &trans                          &trans  &trans             &trans            &trans                 &trans  &trans
&kp LA(TAB)  &cmd_f15 F1   &cmd_f15 F2   &cmd_f15 F3   &cmd_f15 F4   &cmd_f15 F5                     &trans  &trans             &kp LA(LC(UP))    &trans                 &trans  &trans
&trans       &cmd_f15 F6   &cmd_f15 F7   &cmd_f15 F8   &cmd_f15 F9   &cmd_f15 F10                    &trans  &kp LA(LC(PG_UP))  &kp LA(LC(DOWN))  &kp LA(LC(PAGE_DOWN))  &trans  &trans
&trans       &cmd_f15 F11  &cmd_f15 F12  &cmd_f15 F13  &cmd_f15 F14  &cmd_f15 F15  &trans    &trans  &trans  &trans             &trans            &trans                 &trans  &trans
                           &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans             &trans            &trans
            >;

            label = "desk-extra";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num-nav {
            if-layers = <5 1>;
            then-layer = <6>;
        };

        act-sym {
            if-layers = <3 1>;
            then-layer = <4>;
        };

        ext-nav {
            if-layers = <3 5>;
            then-layer = <7>;
        };

        ext-nav-p {
            if-layers = <3 2>;
            then-layer = <7>;
        };

        l-up {
            if-layers = <1 8>;
            then-layer = <9>;
        };

        r-up-sel {
            if-layers = <3 10>;
            then-layer = <11>;
        };
    };
};
