#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        cmb_ru_io {
            bindings = <&kp RU_CYRILLIC_IO>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmb_ru_hs {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <19 20>;
            layers = <1>;
        };

        cmb_home {
            bindings = <&kp HOME>;
            key-positions = <19 20>;
            layers = <3 4>;
        };

        cmb_s_home {
            bindings = <&kp LS(HOME)>;
            key-positions = <19 20>;
            layers = <7>;
        };

        cmd_end {
            bindings = <&kp END>;
            key-positions = <20 21>;
            layers = <3 4>;
        };

        cmb_s_end {
            bindings = <&kp LS(END)>;
            key-positions = <20 21>;
            layers = <7>;
        };
    };

    macros {
        lay_en: lay_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&off 1>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        lay_ru: lay_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&on 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N1))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 23>,
                <&macro_tap>,
                <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <23>;
        };

        ru: ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N2))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 30>,
                <&macro_tap>,
                <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        key: key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap>, <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd: cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd_f15: cmd_f15 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F15>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        nvoff_mo: nvoff_mo {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1 &off MACRO_PLACEHOLDER &macro_param_2to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1 &off MACRO_PLACEHOLDER &off 7>;

            label = "NVOFF_MO";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_EN";
        };

        nav_mo: nav_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&off 7 &macro_param_1to1 &off MACRO_PLACEHOLDER>;

            label = "NAV_MO";
        };

        edt_off_kp: edt_off_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &off 7>;

            label = "EDT_OFF_KP";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        eoff_fnxt: eoff_fnxt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&cmd_f15 F &off 7>;

            label = "EOFF_FNXT";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_RU";
        };

        cmd_f16: cmd_f16 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F16>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
            label = "CMD_F16";
        };
    };

    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        on: on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        off: off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        ltk: ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            hold-while-undecided;
        };

        bksp_del: bksp_del {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_LSFT)>;
            keep-mods = <(MOD_LALT)>;
        };

        sl_bslh_e: sl_bslh_e {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BSLH_E";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sl_bslh_r: sl_bslh_r {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BSLH_R";
            bindings = <&kp RU_SLASH>, <&kp RU_BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_sl: mo_sl {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            label = "MO_SL";
        };

        dqt_no_e: dqt_no_e {
            compatible = "zmk,behavior-mod-morph";
            label = "DQT_NO_E";
            bindings = <&ru RU_DOUBLE_QUOTES>, <&ru RU_NUMERO>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dqt_no_r: dqt_no_r {
            compatible = "zmk,behavior-mod-morph";
            label = "DQT_NO_R";
            bindings = <&kp RU_DOUBLE_QUOTES>, <&kp RU_NUMERO>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ctrl_z_y: ctrl_z_y {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_Z_Y";
            bindings = <&kp LC(Z)>, <&kp LC(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        find_nxt: find_nxt {
            compatible = "zmk,behavior-mod-morph";
            label = "FIND_NXT";
            bindings = <&cmd_f15 F>, <&cmd_f15 LS(F)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_ltk: nav_ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&nav_mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "NAV_LTK";
        };

        exc_sem_e: exc_sem_e {
            compatible = "zmk,behavior-mod-morph";
            label = "EXC_SEM_E";
            bindings = <&kp EXCLAMATION>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        exc_sem_r: exc_sem_r {
            compatible = "zmk,behavior-mod-morph";
            label = "EXC_SEM_R";
            bindings = <&kp RU_EXCLAMATION>, <&kp RU_SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "En";
            bindings = <
&kp ESC           &cmd_f16 F13  &cmd_f16 F14  &cmd_f16 F15  &cmd_f16 F16        &cmd_f16 F17                                        &kp C_MUTE    &kp C_VOL_DN        &sl 12     &kp C_VOL_UP  &bksp_del   &none
&kp ESC           &kp Q         &kp W         &kp E         &kp R               &kp T                                               &kp Y         &kp U               &kp I      &kp O         &kp P       &kp LEFT_BRACKET
&kp TAB           &kp A         &kp S         &kp D         &kp F               &kp G                                               &kp H         &kp J               &kp K      &kp L         &kp SEMI    &kp APOSTROPHE
&sk LEFT_CONTROL  &kp Z         &kp X         &kp C         &kp V               &kp B             &layer_en           &kp ENTER     &kp N         &kp M               &kp COMMA  &kp DOT       &sl_bslh_e  &sk RIGHT_CONTROL
                                &kp GRAVE     &dqt_no_e     &kp_sk LSHFT LSHFT  &nav_ltk 3 SPACE  &ltk 11 CAPSLOCK    &mo_sl 10 10  &ltk 5 SPACE  &kp_sk RSHFT RSHFT  &kp LBKT   &kp RBKT
            >;

            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &trans                   &trans                &trans              &trans              &trans                                &trans              &trans                     &trans               &trans                     &trans               &trans
&trans  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&trans  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE         &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&trans  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans    &trans  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU         &sl_bslh_r           &trans
                                 &kp RU_CYRILLIC_IO    &dqt_no_r           &trans              &trans              &trans    &trans  &trans              &trans                     &kp RU_CYRILLIC_HA   &kp RU_CYRILLIC_HARD_SIGN
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&trans  &none  &none      &none      &none      &none                            &none          &none          &none     &none          &none       &trans
&trans  &none  &none      &on 7      &kp LC(F)  &none                            &kp PAGE_UP    &kp LC(LEFT)   &kp UP    &kp LC(RIGHT)  &none       &none
&trans  &none  &kp LC(S)  &kp LC(D)  &find_nxt  &none                            &key_repeat    &kp LEFT       &kp DOWN  &kp RIGHT      &kp DELETE  &none
&trans  &none  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none          &trans    &trans  &kp PAGE_DOWN  &kp BACKSPACE  &none     &none          &none       &trans
               &none      &none      &trans     &nvoff_mo 2 3  &trans    &trans  &trans         &trans         &none     &none
            >;
        };

        nav-sym-en {
            display-name = "nav_sym";
            bindings = <
&none        &none          &none        &none      &none      &none                         &kp C_PP       &kp C_PREV     &none          &kp C_NEXT        &none       &none
&kp LS(ESC)  &ru RU_NUMERO  &key_repeat  &on 7      &kp LC(F)  &none                         &kp PG_UP      &kp LC(LEFT)   &kp UP         &kp LC(RIGHT)     &kp COLON   &kp PIPE
&none        &lay_ru        &kp LC(S)    &kp LC(D)  &find_nxt  &kp GRAVE                     &kp AMPERSAND  &kp LEFT       &kp DOWN       &kp RIGHT         &kp DELETE  &kp DOUBLE_QUOTES
&none        &kp TILDE      &kp LC(X)    &kp LC(C)  &kp LC(V)  &kp DOLLAR  &trans    &trans  &kp PG_DN      &kp BACKSPACE  &kp LESS_THAN  &kp GREATER_THAN  &kp HASH    &none
                            &none        &none      &trans     &trans      &trans    &trans  &trans         &trans         &none          &none
            >;
        };

        nav-sym-ru {
            display-name = "nav-sym";
            bindings = <
&trans  &trans         &trans  &trans  &trans  &trans                        &trans         &trans  &trans         &trans            &trans        &trans
&trans  &kp RU_NUMERO  &trans  &trans  &trans  &trans                        &trans         &trans  &trans         &trans            &kp RU_COLON  &en PIPE
&trans  &lay_en        &trans  &trans  &trans  &en GRAVE                     &en AMPERSAND  &trans  &trans         &trans            &trans        &kp RU_DOUBLE_QUOTES
&trans  &en TILDE      &trans  &trans  &trans  &en DOLLAR  &trans    &trans  &trans         &trans  &en LESS_THAN  &en GREATER_THAN  &en HASH      &trans
                       &trans  &trans  &trans  &trans      &trans    &trans  &trans         &trans  &trans         &trans
            >;
        };

        num-sym-en {
            display-name = "num_sym";
            bindings = <
&none        &cmd_f16 F18  &cmd_f16 F19      &cmd_f16 F20       &cmd_f16 F21    &cmd_f16 F22                       &none            &none           &none                 &none                  &none          &none
&none        &kp N1        &kp N2            &kp N3             &kp N4          &kp N5                             &kp PERCENT      &kp CARET       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &none
&kp LS(TAB)  &kp N6        &kp N7            &kp N8             &kp N9          &kp N0                             &kp EXCLAMATION  &kp MINUS       &kp PLUS              &kp ASTERISK           &kp ENTER      &kp APOSTROPHE
&none        &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans    &trans  &kp AT           &kp UNDERSCORE  &kp COMMA             &kp DOT                &kp QUESTION   &none
                           &none             &none              &trans          &trans           &trans    &trans  &trans           &trans          &none                 &none
            >;
        };

        num-sym-ru {
            display-name = "num-sym";
            bindings = <
&trans  &trans  &trans            &trans             &trans          &trans                             &trans              &trans     &trans        &trans      &trans            &trans
&trans  &trans  &trans            &trans             &trans          &trans                             &kp RU_PERCENT      &en CARET  &trans        &trans      &kp RU_SEMICOLON  &trans
&trans  &trans  &trans            &trans             &trans          &trans                             &kp RU_EXCLAMATION  &trans     &trans        &trans      &trans            &en APOSTROPHE
&trans  &trans  &en LEFT_BRACKET  &en RIGHT_BRACKET  &en LEFT_BRACE  &en RIGHT_BRACE  &trans    &trans  &en AT              &trans     &kp RU_COMMA  &kp RU_DOT  &kp RU_QUESTION   &trans
                &trans            &trans             &trans          &trans           &trans    &trans  &trans              &trans     &trans        &trans
            >;
        };

        nav-sel {
            display-name = "nav-sel";
            bindings = <
&none                &none  &none              &none              &none              &none                     &none              &none                  &none         &none              &none               &none
&edt_off_kp LS(ESC)  &none  &none              &off 7             &edt_off_kp LC(F)  &none                     &kp LS(PG_UP)      &kp LC(LS(LEFT))       &kp LS(UP)    &kp LC(LS(RIGHT))  &none               &none
&none                &none  &edt_off_kp LC(S)  &edt_off_kp LC(D)  &eoff_fnxt         &none                     &key_repeat        &kp LS(LEFT)           &kp LS(DOWN)  &kp LS(RIGHT)      &edt_off_kp DELETE  &none
&none                &none  &edt_off_kp LC(X)  &edt_off_kp LC(C)  &edt_off_kp LC(V)  &none   &trans    &trans  &kp LS(PAGE_DOWN)  &edt_off_kp BACKSPACE  &none         &none              &none               &none
                            &none              &none              &trans             &trans  &trans    &trans  &trans             &trans                 &none         &none
            >;

            label = "nav-sel";
        };

        ext-nav {
            display-name = "ext-nav";
            bindings = <
&bootloader   &none  &kp F23        &none          &kp F24        &none                      &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4    &bt BT_CLR
&none         &none  &none          &on 7          &none          &none                      &kp LC(HOME)  &kp HOME           &kp PG_UP     &kp END        &none           &none
&none         &none  &kp LS(LG(S))  &kp LC(E)      &none          &none                      &kp LC(END)   &kp LA(LEFT)       &kp PG_DN     &kp LA(RIGHT)  &kp LS(DELETE)  &none
&out OUT_USB  &none  &kp LS(LC(X))  &kp LS(LC(C))  &kp LS(LC(V))  &kp INS  &trans    &trans  &none         &kp LS(BACKSPACE)  &none         &none          &none           &out OUT_BLE
                     &none          &none          &trans         &trans   &trans    &trans  &trans        &trans             &none         &none
            >;
        };

        ext-nav-sel {
            bindings = <
&trans  &trans  &trans                 &trans                 &trans                 &trans                    &trans            &trans                     &trans         &trans             &trans                  &trans
&trans  &trans  &trans                 &off 7                 &trans                 &trans                    &kp LS(LC(HOME))  &kp LS(HOME)               &kp LS(PG_UP)  &kp LS(END)        &trans                  &trans
&trans  &trans  &trans                 &kp LC(E)              &trans                 &trans                    &kp LS(LC(END))   &kp LS(LA(LEFT))           &kp LS(PG_DN)  &kp LS(LA(RIGHT))  &edt_off_kp LS(DELETE)  &trans
&trans  &trans  &edt_off_kp LS(LC(X))  &edt_off_kp LS(LC(C))  &edt_off_kp LS(LC(V))  &trans  &trans    &trans  &trans            &edt_off_kp LS(BACKSPACE)  &trans         &trans             &trans                  &trans
                &trans                 &trans                 &trans                 &trans  &trans    &trans  &trans            &trans                     &trans         &trans
            >;

            label = "ext-nav-sel";
        };

        fn {
            bindings = <
&none  &none    &none    &none    &none    &none                      &none   &none   &none  &none  &none          &none
&none  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                     &none   &none   &none  &none  &none          &none
&none  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                    &none   &none   &none  &none  &kp LS(ENTER)  &none
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans    &trans  &none   &none   &none  &none  &none          &none
                &none    &none    &trans   &on 2    &trans    &trans  &trans  &trans  &none  &none
            >;

            label = "fn";
        };

        utils {
            display-name = "utils";
            bindings = <
&none  &none      &none      &none      &none      &none                     &none      &none                &none              &none                  &none          &none
&none  &none      &none      &none      &none      &none                     &none      &kp LC(Z)            &kp LC(LA(UP))     &kp LC(Y)              &none          &none
&none  &layer_en  &none      &none      &none      &none                     &none      &kp LC(LA(PAGE_UP))  &kp LC(LA(DOWN))   &kp LC(LA(PAGE_DOWN))  &none          &none
&none  &none      &kp LA(X)  &kp LA(C)  &kp LA(V)  &none   &trans    &trans  &kp F16    &sk LEFT_ALT         &sk RIGHT_CONTROL  &sk LGUI               &kp LC(SLASH)  &none
                  &none      &none      &trans     &trans  &trans    &trans  &kp SPACE  &sk LSHFT            &none              &none
            >;
        };

        desktop {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &cmd_f15 F1   &cmd_f15 F2   &cmd_f15 F3   &cmd_f15 F4   &cmd_f15 F5                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &cmd_f15 F6   &cmd_f15 F7   &cmd_f15 F8   &cmd_f15 F9   &cmd_f15 F10                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &cmd_f15 F11  &cmd_f15 F12  &cmd_f15 F13  &cmd_f15 F14  &cmd_f15 F15  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "desktop";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        numsymru {
            if-layers = <5 1>;
            then-layer = <6>;
        };

        fnnavru {
            if-layers = <3 1>;
            then-layer = <4>;
        };

        ext-nav {
            if-layers = <3 5>;
            then-layer = <8>;
        };

        ext-nav-sel {
            if-layers = <3 5 7>;
            then-layer = <9>;
        };
    };
};
