#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        cmb_ru_io {
            bindings = <&kp RU_CYRILLIC_IO>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmb_ru_hs {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <20 19>;
            layers = <1>;
        };

        cmb_lay_en {
            bindings = <&lay_en>;
            key-positions = <15 20>;
            layers = <1>;
        };

        cmb_lay_ru {
            bindings = <&lay_ru>;
            key-positions = <15 20>;
            layers = <0>;
        };

        cmb_dot_ru {
            bindings = <&kp RU_DOT>;
            key-positions = <46 47>;
            layers = <1>;
        };

        cmb_dot_en {
            bindings = <&kp DOT>;
            key-positions = <46 47>;
            layers = <0>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <14 21>;
            layers = <0 1>;
        };

        cmb_nav {
            bindings = <&nav_mo 2>;
            key-positions = <53 56>;
            slow-release;
            timeout-ms = <175>;
        };
    };

    macros {
        lay_en: lay_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&off 1>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        lay_ru: lay_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&on 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <38>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N1))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 23>,
                <&macro_tap>,
                <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <23>;
        };

        ru: ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N2))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 30>,
                <&macro_tap>,
                <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        key: key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap>, <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd: cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        cmd_f15: cmd_f15 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F15>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
        };

        nvoff_mo: nvoff_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&off 2 &macro_param_1to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER &kt_off LSHFT>;

            label = "NVOFF_MO";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_tap>, <&kp LS(LC(N1))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_EN";
        };

        nav_mo: nav_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER>;

            label = "NAV_MO";
            wait-ms = <0>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_tap>, <&kp LS(LC(N2))>;

            wait-ms = <0>;
            tap-ms = <50>;
            label = "LAYER_RU";
        };

        cmd_f16: cmd_f16 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F16>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
            label = "CMD_F16";
        };

        nav_mo_l: nav_mo_l {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER &off 9>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER &kt_off LSHFT>;

            label = "NAV_MO_L";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        ext_nav_mo_l: ext_nav_mo_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&on 2 &off 9 &off 7>,
                <&macro_press>,
                <&kp RSHFT>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&off 2>,
                <&macro_release>,
                <&kp RSHFT>;

            label = "EXT_NAV_MO_L";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        l_up_mo: l_up_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &on MACRO_PLACEHOLDER &off 7>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER>;

            label = "L_UP_MO";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        kp_on_off: kp_on_off {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &kt_off MACRO_PLACEHOLDER &macro_param_1to1 &kt_on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_press>,
                <&macro_param_1to1 &kt_off MACRO_PLACEHOLDER>;

            label = "KP_ON_OFF";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        sel_off_kp: sel_off_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kt_off LSHFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 0>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "SEL_OFF_KP";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        nv_off_rel: nv_off {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_pause_for_release>,
                <&macro_param_1to1 &off MACRO_PLACEHOLDER &kt_off LSHFT>;

            label = "NV_OFF";
        };

        sel_off_cmd_f15: sel_off_cmd_f15 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kt_off LSHFT>,
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F15>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            wait-ms = <0>;
            tap-ms = <30>;
            label = "SEL_OFF_CMD_F15";
        };
    };

    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        on: on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        off: off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        ltk: ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
        };

        sl_bksl_e: sl_bksl_e {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BKSL_E";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sl_bksl_r: sl_bksl_r {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_BKSL_R";
            bindings = <&sl_mod>, <&kp RU_BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_sl: mo_sl {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            label = "MO_SL";
        };

        find_nxt: find_nxt {
            compatible = "zmk,behavior-mod-morph";
            label = "FIND_NXT";
            bindings = <&cmd_f15 F>, <&cmd_f15 LS(F)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        nav_ltk: nav_ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&nav_mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "NAV_LTK";
        };

        lr_bkt: lr_bkt {
            compatible = "zmk,behavior-mod-morph";
            label = "LR_BKT";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            flavor = "hold-preferred";
            label = "KP_SK";
            hold-while-undecided;
            hold-while-undecided-linger;
        };

        l_up_ltk: l_up_ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&l_up_mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "L_UP_LTK";
        };

        kt_off: kt_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KT_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        kt_flip: kt_flip {
            compatible = "zmk,behavior-key-toggle";
            label = "KT_FLIP";
            #binding-cells = <1>;
            toggle-mode = "flip";
        };

        kp_ktgl: kp_ktgl {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp_on_off>, <&kt_flip>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            flavor = "tap-preferred";
            label = "KP_KTGL";
        };

        kt_on: kt_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KT_ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        nav_bksp: nav_bksp {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_BKSP";
            bindings = <&kp BACKSPACE>, <&sel_off_kp BACKSPACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        nav_mo_on: nav_mo_on {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_MO_ON";
            bindings = <&ext_nav_mo_l>, <&on>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <235>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 56 57 58 59 43 55>;
        };

        nav_mo_a: nav_mo_a {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_MO_A";
            bindings = <&ext_nav_mo_l>, <&kt_off>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 56 57 58 59 43 55>;
        };

        ca_up_down: ca_up_down {
            compatible = "zmk,behavior-mod-morph";
            label = "CA_UP_DOWN";
            bindings = <&kp LC(LA(DOWN))>, <&kp LA(LC(UP))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT)>;
        };

        nav_tab: nav_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_TAB";
            bindings = <&kp TAB>, <&sel_off_kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RSFT|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        nav_stab: nav_stab {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_STAB";
            bindings = <&kp LS(TAB)>, <&sel_off_kp LS(TAB)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RSFT|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        nav_esc: nav_esc {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_ESC";
            bindings = <&kp ESC>, <&sel_off_kp ESC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RSFT|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        nav_off_ltk: nav_off_ltk {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&nvoff_mo>, <&nav_space>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            flavor = "hold-preferred";
            label = "NAV_OFF_LTK";
        };

        nav_enter: nav_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_ENTER";
            bindings = <&kp ENTER>, <&sel_off_kp ENTER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RSFT|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        nav_space: nav_space {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_SPACE";
            bindings = <&kp SPACE>, <&sel_off_kp SPACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RSFT|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        nav_ctrl_z: nav_ctrl_z {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_Z";
            bindings = <&kp LC(Z)>, <&sel_off_kp LC(Z)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        nav_ctrl_x: nav_ctrl_x {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_X";
            bindings = <&sel_off_kp LC(X)>, <&sel_off_kp LA(X)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        nav_ctrl_c: nav_ctrl_c {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_C";
            bindings = <&sel_off_kp LC(C)>, <&sel_off_kp LA(C)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        nav_ctrl_v: nav_ctrl_v {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_V";
            bindings = <&sel_off_kp LC(V)>, <&sel_off_kp LA(V)>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        nav_ctrl_y: nav_ctrl_y {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_Y";
            bindings = <&nv_ctrl_y_ext>, <&sel_off_kp LC(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        nav_ctrl_d: nav_ctrl_d {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_D";
            bindings = <&kp LC(D)>, <&sel_off_kp LC(D)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        nav_ctrl_s: nav_ctrl_s {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_CTRL_S";
            bindings = <&sel_off_kp LC(S)>, <&sel_off_kp LC(S)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        nav_del: nav_del {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_DEL";
            bindings = <&kp DELETE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        nav_ins: nav_ins {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_INS";
            bindings = <&kp INSERT>, <&kp INSERT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        nav_find_nxt: nav_find_nxt {
            compatible = "zmk,behavior-mod-morph";
            label = "NAV_FIND_NXT";
            bindings = <&find_nxt>, <&sel_off_cmd_f15 F>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        nv_ctrl_y_ext: nv_ctrl_y_ext {
            compatible = "zmk,behavior-mod-morph";
            label = "NV_CTRL_Y_EXT";
            bindings = <&kp LC(Y)>, <&kp LC(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sl_mod: sl_mod {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_MOD";
            bindings = <&kp RU_SLASH>, <&kp RU_DOT>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "En";
            bindings = <
&kp ESC         &kp LGUI  &kp LSHFT      &kp LCTRL   &kp LALT            &key_repeat                               &none             &kp LALT            &kp RCTRL     &kp RSHFT     &kp RGUI    &none
&kp TAB         &kp Q     &kp W          &kp E       &kp R               &kp T                                     &kp Y             &kp U               &kp I         &kp O         &kp P       &lr_bkt
&nav_mo_on 0 2  &kp A     &kp S          &kp D       &kp F               &kp G                                     &kp H             &kp J               &kp K         &kp L         &kp SEMI    &kp APOSTROPHE
&layer_en       &kp Z     &kp X          &kp C       &kp V               &kp B         &kp CAPSLOCK    &kp ENTER   &kp N             &kp M               &kp COMMA     &kp DOT       &sl_bksl_e  &layer_ru
                          &kp LS(LC(M))  &kp C_MUTE  &kp_sk LSHFT LSHFT  &ltk 3 SPACE  &mo_sl 7 7      &mo_sl 9 9  &nav_ltk 5 SPACE  &kp_sk RSHFT RSHFT  &kp C_VOL_DN  &kp C_VOL_UP
            >;

            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &trans                   &trans                &trans              &trans              &trans                                 &trans              &trans                     &trans               &trans                 &trans               &trans
&trans  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                     &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&trans  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                     &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&trans  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans    &lay_en  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &sl_bksl_r           &trans
                                 &trans                &trans              &trans              &trans              &trans    &trans   &trans              &trans                     &trans               &trans
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&trans             &trans       &trans             &trans                &trans         &trans                           &trans                &trans        &trans     &trans         &trans      &trans
&nav_tab           &none        &sel_off_kp LC(E)  &kp_ktgl LSHFT LSHFT  &none          &none                            &kp LC(HOME)          &kp LC(LEFT)  &kp UP     &kp LC(RIGHT)  &nav_ins    &none
&nav_mo_a 0 LSHFT  &nav_esc     &nav_ctrl_s        &nav_ctrl_d           &nav_find_nxt  &none                            &nav_bksp             &kp LEFT      &kp DOWN   &kp RIGHT      &nav_enter  &nav_del
&trans             &nav_ctrl_z  &nav_ctrl_x        &nav_ctrl_c           &nav_ctrl_v    &none          &trans    &trans  &kp LC(END)           &kp HOME      &kp PG_DN  &kp PG_UP      &kp END     &trans
                                &none              &none                 &trans         &nv_off_rel 2  &trans    &trans  &nav_off_ltk 5 SPACE  &trans        &none      &none
            >;
        };

        act-sym-en {
            display-name = "act_sym";
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                    &trans           &trans         &trans                &trans                 &trans        &trans
&none   &none      &kp CAPS   &lay_ru    &lay_en    &none                     &kp EXCLAMATION  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CARET     &kp PIPE
&none   &kp ESC    &kp LC(S)  &kp LC(D)  &find_nxt  &none                     &kp PLUS         &kp MINUS      &kp UNDERSCORE        &kp EQUAL              &kp COLON     &kp DOUBLE_QUOTES
&none   &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none   &trans    &trans  &kp AT           &kp AMPERSAND  &kp LT                &kp GT                 &kp QUESTION  &none
                   &none      &none      &trans     &trans  &trans    &trans  &trans           &trans         &kp C_PREV            &kp C_NEXT
            >;
        };

        act-sym-ru {
            display-name = "act-sym";
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans                    &trans       &trans         &trans  &trans  &trans           &trans
&trans  &trans  &trans  &lay_en  &trans  &trans                    &kp RU_EXCL  &trans         &trans  &trans  &en CARET        &en PIPE
&trans  &trans  &trans  &trans   &trans  &trans                    &trans       &trans         &trans  &trans  &kp RU_COLON     &kp RU_DOUBLE_QUOTES
&trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans  &en AT       &en AMPERSAND  &en LT  &en GT  &kp RU_QUESTION  &trans
                &trans  &trans   &trans  &trans  &trans    &trans  &trans       &trans         &trans  &trans
            >;
        };

        num-nav-en {
            display-name = "num_nav";
            bindings = <
&trans          &trans     &trans            &trans             &trans   &trans                         &trans         &trans        &trans     &trans         &trans      &trans
&kp GRAVE       &kp N1     &kp N2            &kp N3             &kp N4   &kp N5                         &kp LC(HOME)   &kp LC(LEFT)  &kp UP     &kp LC(RIGHT)  &kp INSERT  &none
&kp APOSTROPHE  &kp N6     &kp N7            &kp N8             &kp N9   &kp N0                         &kp BACKSPACE  &kp LEFT      &kp DOWN   &kp RIGHT      &kp ENTER   &kp DELETE
&none           &kp COMMA  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOT  &kp PERCENT  &trans    &trans  &kp LC(END)    &kp HOME      &kp PG_DN  &kp PG_UP      &kp END     &none
                           &none             &kp C_PP           &trans   &trans       &trans    &trans  &trans         &trans        &none      &none
            >;
        };

        num-nav-ru {
            display-name = "num-nav";
            bindings = <
&trans          &trans        &trans            &trans             &trans      &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&en GRAVE       &trans        &trans            &trans             &trans      &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&en APOSTROPHE  &trans        &trans            &trans             &trans      &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp RU_COMMA  &en LEFT_BRACKET  &en RIGHT_BRACKET  &kp RU_DOT  &kp RU_PERCENT  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans            &trans             &trans      &trans          &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        desk-fn-en {
            display-name = "desk_fn";
            bindings = <
&bootloader   &none         &kp F23       &none         &kp F24       &none                           &trans      &trans     &trans          &trans           &trans         &trans
&none         &cmd_f15 F1   &cmd_f15 F2   &cmd_f15 F3   &cmd_f15 F4   &cmd_f15 F5                     &kp F11     &kp F12    &kp F13         &kp F14          &kp F15        &kp F16
&none         &cmd_f15 F6   &cmd_f15 F7   &cmd_f15 F8   &cmd_f15 F9   &cmd_f15 F10                    &kp HASH    &kp TILDE  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp SEMICOLON  &ru RU_NUMERO
&out OUT_USB  &cmd_f15 F11  &cmd_f15 F12  &cmd_f15 F13  &cmd_f15 F14  &cmd_f15 F15  &trans    &trans  &kp DOLLAR  &sk LALT   &sk RCTRL       &sk RSHFT        &sk RGUI       &none
                            &none         &none         &trans        &trans        &trans    &trans  &trans      &trans     &none           &none
            >;
        };

        desk-fn-ru {
            display-name = "desk-fn";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans      &trans     &trans          &trans           &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans      &trans     &trans          &trans           &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &en HASH    &en TILDE  &en LEFT_BRACE  &en RIGHT_BRACE  &kp RU_SEMICOLON  &kp RU_NUMERO
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &en DOLLAR  &trans     &trans          &trans           &trans            &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans      &trans     &trans          &trans
            >;
        };

        fn-utils {
            display-name = "fn-utils";
            bindings = <
&trans  &trans    &trans     &trans     &trans    &trans                       &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4     &bt BT_CLR
&none   &kp F1    &kp F2     &kp F3     &kp F4    &kp F5                       &none         &kp LA(LC(PG_UP))    &kp LA(LC(UP))     &kp LA(LC(PG_DN))  &kp PAUSE_BREAK  &none
&none   &kp F6    &kp F7     &kp F8     &kp F9    &kp F10                      &key_repeat   &kp LA(LEFT)         &kp LA(LC(DOWN))   &kp LA(RIGHT)      &kp LC(ENTER)    &kp PRINTSCREEN
&none   &sk LGUI  &sk LSHFT  &sk LCTRL  &sk LALT  &kp K_APP  &trans    &trans  &none         &kp C_AL_CALCULATOR  &kp LA(LC(PG_DN))  &kp LA(LC(PG_UP))  &kp SCROLLLOCK   &out OUT_BLE
                  &none      &none      &trans    &trans     &trans    &trans  &trans        &trans               &none              &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num-nav {
            if-layers = <5 1>;
            then-layer = <6>;
        };

        act-sym {
            if-layers = <3 1>;
            then-layer = <4>;
        };

        desk-fn {
            if-layers = <7 1>;
            then-layer = <8>;
        };
    };
};
